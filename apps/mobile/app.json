{
  "expo": {
    "name": "flux",
    "slug": "flux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flux-icon.png",
    "scheme": "flux",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.werlesson.flux",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#15100F",
        "foregroundImage": "./assets/images/flux-mark.png",
        "monochromeImage": "./assets/images/flux-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15100F",
          "image": "./assets/images/flux-mark.png",
          "imageWidth": 104
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
